if [ "$PS1" ]; then
    if [ "$BASH" ] && [ "$BASH" != "/bin/sh" ]; then
        : # do nothing
    elif [ "$(id -u)" -eq 0 ]; then
        PS1='# '
    else
        PS1='$ '
    fi
fi

if [ -d "$HOME/.rvm/bin" ] ; then
    export PATH="${PATH}:$HOME/.rvm/bin"
fi

if [ "$(uname)" = "Darwin" ]
then # Dynamic JAVA_HOME detection
    if [ -x /usr/libexec/java_home ]
    then
        export JAVA_HOME=$(/usr/libexec/java_home)
    fi
else # Linux Java paths (OpenJDK)
    # Find all OpenJDK directories, sort by version, and pick the latest one
    latest_jvm=$(ls -d /usr/lib/jvm/java-*-openjdk-* 2>/dev/null | sort -V | tail -n 1)
    if [ -d "$latest_jvm" ]
    then
        export JAVA_HOME="$latest_jvm"
    fi
fi

if [ -n "$JAVA_HOME" ]; then
    export PATH="$JAVA_HOME/bin:$PATH"
fi

if [ -d "$HOME/.root/bin" ] ; then
    export PATH="$HOME/.root/bin:$PATH"
fi

export TZ='Asia/Seoul';

if [ -f "$HOME/.cargo/env" ]
then
    . "$HOME/.cargo/env"
fi

if [ -f /home/linuxbrew/.linuxbrew/bin/brew ] ; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -f /opt/homebrew/bin/brew ] ; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if [ -d "$HOME/.rd/bin" ]
then
    export PATH="$HOME/.rd/bin:$PATH"
fi

