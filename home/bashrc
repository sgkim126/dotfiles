# If not running interactively, don't do anything
[ -z "$PS1" ] && return

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "$debian_chroot" ] && [ -r /etc/debian_chroot ]
then
    debian_chroot=$(cat /etc/debian_chroot)
fi

. ~/.bash_color

alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# Set EDITOR to nvim if available, otherwise fallback to vim
if command -v nvim >/dev/null 2>&1; then
    export EDITOR='nvim'
    alias vi='nvim'
else
    export EDITOR='vim'
    alias vi='vim'
fi

# Locale settings - Safer approach for SSH
export LANG='ko_KR.UTF-8'
# Only set other LC_* if they are likely to be supported or specifically needed
# export LC_ALL='ko_KR.UTF-8'

umask 022

# if the command-not-found package is installed, use it
if [ -x /usr/lib/command-not-found ]; then
    command_not_found_handle() {
        # check because c-n-f could've been removed in the meantime
        if [ -x /usr/lib/command-not-found ]; then
            /usr/bin/python /usr/lib/command-not-found -- $1
            return $?
        else
            return 127
        fi
    }
fi

if [ -f /etc/bash_completion ]
then
    . /etc/bash_completion
fi
if [ -d "$HOME/.bash_complete.d" ]
then
    for f in "$HOME/.bash_complete.d/"*; do
        [ -f "$f" ] && . "$f"
    done
fi
if [ -f /opt/homebrew/etc/bash_completion ]
then
    . /opt/homebrew/etc/bash_completion
fi


if [ -f "$HOME/.rvm/scripts/rvm" ]
then
    . "$HOME/.rvm/scripts/rvm"
fi

[[ -s "$HOME/.rsvm/rsvm.sh" ]] && . "$HOME/.rsvm/rsvm.sh" # This loads RSVM

if [ -f "$HOME/.bash_local" ]
then
    . "$HOME/.bash_local"
fi

if command -v mate-screensaver-command >/dev/null 2>&1
then
    iwillworkfor() {
        echo "mate-screensaver-command --lock" | at now + $1 $2
    }
    iwillworkuntil() {
        echo "mate-screensaver-command --lock" | at $@
    }
elif command -v gnome-screensaver-command >/dev/null 2>&1
then
    iwillworkfor() {
        echo "gnome-screensaver-command --lock" | at now + $1 $2
    }
    iwillworkuntil() {
        echo "gnome-screensaver-command --lock" | at $@
    }
fi

export OPENCODE_EXPERIMENTAL_DISABLE_COPY_ON_SELECT=true

# run_at 17:30 echo hello world
run_at() {
  local target="$1"
  shift
  local cmd="$*"

  local target_timestamp=$(date -j -f "%H:%M:%S" "${target}:00" +%s 2>/dev/null || date -d "today ${target}:00" +%s 2>/dev/null)
  if [[ -z "$target_timestamp" ]]; then
    echo "invalid time format: $target" >&2
    return 1
  fi

  # 이미 지난 시간이면 다음 날로
  local now=$(date +%s)
  if (( target_timestamp <= now )); then
    target_timestamp=$((target_timestamp + 86400))
  fi

  local wait=$((target_timestamp - now))
  run_after ${wait}s $cmd
}

# run_after 1h10m echo hello world
run_after() {
  local duration="$1"
  shift
  local cmd="$*"

  local seconds=0
  local tmp="$duration"

  if [[ "$tmp" =~ ^([0-9]+)d ]]; then
    seconds=$((seconds + ${BASH_REMATCH[1]} * 86400))
    tmp="${tmp#${BASH_REMATCH[0]}}"
  fi
  if [[ "$tmp" =~ ^([0-9]+)h ]]; then
    seconds=$((seconds + ${BASH_REMATCH[1]} * 3600))
    tmp="${tmp#${BASH_REMATCH[0]}}"
  fi
  if [[ "$tmp" =~ ^([0-9]+)m ]]; then
    seconds=$((seconds + ${BASH_REMATCH[1]} * 60))
    tmp="${tmp#${BASH_REMATCH[0]}}"
  fi
  if [[ "$tmp" =~ ^([0-9]+)s ]]; then
    seconds=$((seconds + ${BASH_REMATCH[1]}))
    tmp="${tmp#${BASH_REMATCH[0]}}"
  fi

  if [[ -n "$tmp" ]]; then
    echo "invalid duration format: $duration" >&2
    return 1
  fi

  local target_timestamp=$(($(date +%s) + seconds))
  echo "scheduled at $(date -r $target_timestamp 2>/dev/null || date -d @$target_timestamp)"
  sleep "$seconds" && eval "$cmd"
}

